{
  "name": "@lab/portal-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "worker": "tsx --conditions=@lab/source src/cli.ts",
    "collect:jira": "tsx --conditions=@lab/source src/collect-jira.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --conditions=@lab/dist --import ./dist/instrumentation.js dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "scorecard": "tsx --conditions=@lab/source src/scorecard-cli.ts"
  },
  "dependencies": {
    "@lab/contracts": "*",
    "@lab/database": "*",
    "@lab/dora": "*",
    "@lab/eng-metrics": "*",
    "@lab/flow": "*",
    "@lab/telemetry": "*",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
