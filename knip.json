{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"]
    },
    "apps/api": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "tools/review-bot": {
      "entry": ["src/cli.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "tools/eng-metrics": {
      "entry": ["src/cli.ts", "src/digest-cli.ts", "src/contract.ts", "src/collect.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/panel": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"],
      "ignore": ["src/components/ui/**"]
    },
    "tools/mcp-context": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/portal-api": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/portal-worker": {
      "entry": ["src/cli.ts", "src/scorecard-cli.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/portal-web": {
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"],
      "ignore": ["src/components/ui/**", "src/hooks/use-mobile.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/testing.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  },
  "ignoreDependencies": ["jscpd"]
}
