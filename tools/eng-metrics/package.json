{
  "name": "@lab/eng-metrics",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "panel": "tsx src/cli.ts",
    "digest": "tsx src/digest-cli.ts",
    "deploy-event": "tsx src/deploy-event-cli.ts"
  },
  "exports": {
    "./contract": {
      "@lab/dist": "./dist/src/contract.js",
      "default": "./src/contract.ts"
    },
    "./collect": {
      "@lab/dist": "./dist/src/collect.js",
      "default": "./src/collect.ts"
    }
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
