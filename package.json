{
  "name": "eng-platform-lab",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "diff-coverage": "node scripts/diff-coverage.mjs",
    "quality": "node scripts/quality-report.mjs",
    "pre-pr": "node scripts/pre-pr.mjs",
    "verify": "npm run lint && npm run format && npm run typecheck && npm run test:coverage && npm run build",
    "review": "npm run review --workspace @lab/review-bot --",
    "panel": "npm run panel --workspace @lab/eng-metrics --",
    "digest": "npm run digest --workspace @lab/eng-metrics --",
    "chat-evals": "npm run chat-evals --workspace @lab/portal-api --",
    "deploy-event": "npm run deploy-event --workspace @lab/eng-metrics --"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "knip": "^6.47.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.33"
    }
  }
}
